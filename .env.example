# ============================================
# দৌলখাঁড় পূর্বপাড়া হিলফুল ফুযুল ফাউন্ডেশন
# Fund Management App — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase Configuration (required)
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service key (required by payments / reset-password / auto-link /
# sheets sync routes). NEVER expose this to the browser — it bypasses RLS.
NEXT_SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin used in QR links, receipt URLs and WhatsApp share links.
# Falls back to the request host when unset, which breaks behind proxies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (optional — notify/whatsapp route no-ops without these)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Optional: Vercel environment variables
# Set these in Vercel Dashboard → Project Settings → Environment Variables
# NEXT_PUBLIC_APP_NAME=দৌলখাঁড় পূর্বপাড়া হিলফুল ফুযুল ফাউন্ডেশন

# Google Sheets Auto-Backup (optional)
# See: docs/development/GOOGLE_SHEETS_SETUP.md
# GOOGLE_SERVICE_ACCOUNT_JSON=<contents of your service-account JSON key — raw JSON, do NOT wrap in extra quotes>
# GOOGLE_SHEET_ID=<spreadsheet id from its URL>
